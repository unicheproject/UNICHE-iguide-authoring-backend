# Copy to `.env` and fill in. `.env` is never committed.
#
# The UNICHE platform services are already deployed and are consumed as remote services:
#
#   UNICHE IdP        https://idp.uniche-eccch.eu/
#   Keycloak realm    https://idp.uniche-eccch.eu/realms/uniche
#   UNICHE Catalogue  https://catalogue.uniche-eccch.eu/
#   UNICHE Portal     https://platform.uniche-eccch.eu/   (the Portal SPA, not the Catalogue)
#
# These URLs live here and in deployment configuration only. They are never property defaults: a
# silent production default makes a misconfigured deployment look healthy while it reads or writes
# the wrong platform instance.

# --- Required. The application refuses to start without these two. ---
IDP_ISSUER_URI=https://idp.uniche-eccch.eu/realms/uniche
CATALOGUE_BASE_URL=https://catalogue.uniche-eccch.eu

# --- Database ---
# DB_URL applies when running the application straight from Maven. Under compose the app service
# overrides it to reach the postgres service by name.
DB_URL=jdbc:postgresql://localhost:5432/iguide
POSTGRES_DB=iguide
DB_USERNAME=iguide
DB_PASSWORD=change-me

# --- Platform identity of this tool, as registered in the Catalogue ---
TOOL_SLUG=iguide

# --- Browser origins allowed to call this backend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Asset storage variables arrive with the assets milestone, when something reads them.

# --- HTTP ---
SERVER_PORT=8080
